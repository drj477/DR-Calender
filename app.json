{
  "expo": {
    "name": "DR Calender",
    "slug": "dr-calender",
    "scheme": "drcalender",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0C0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drj477.drcalender",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.drj477.drcalender"
        ]
      }
    },
    "android": {
      "package": "com.drj477.drcalender",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders",
          "color": "#FFC247"
        }
      ],
      "expo-secure-store",
      "./plugins/withDRCalenderNative",
      "@bacons/apple-targets"
    ]
  }
}
