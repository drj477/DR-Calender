{
  "name": "dr-calender",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first collaborative calendar and scheduling app",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-apple-targets.js"
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-sqlite": "~15.2.14",
    "expo-notifications": "~0.31.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "zustand": "^5.0.8",
    "expo-secure-store": "~14.2.3",
    "expo-modules-core": "~2.4.0",
    "expo-file-system": "~18.1.11",
    "expo-document-picker": "~13.1.6",
    "expo-sharing": "~13.1.5",
    "@bacons/apple-targets": "4.0.7",
    "expo-asset": "~11.1.5",
    "@expo/config-plugins": "~10.1.2",
    "@expo/image-utils": "~0.7.6"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "postcss": "8.5.23",
    "image-size": "2.0.4"
  }
}
